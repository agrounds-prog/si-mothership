# Required teacher key. Change this before a public deployment.
MOTHERSHIP_TEACHER_KEY=5030

# Mount a Railway Volume at /data and use this path for persistent SQLite data.
MOTHERSHIP_DATA_DIR=/data

# Railway injects PORT and RAILWAY_PUBLIC_DOMAIN automatically.
# PUBLIC_BASE_URL is optional; the server derives https://$RAILWAY_PUBLIC_DOMAIN.
MOTHERSHIP_NO_BROWSER=1
